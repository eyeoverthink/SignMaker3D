{
  "info": {
    "name": "Sign-Sculptor API",
    "description": "Complete API collection for Sign-Sculptor 3D LED sign generation platform with 47+ generators",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Core Exports",
      "item": [
        {
          "name": "Export Sign (Basic)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/api/export",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"HELLO\",\n  \"fontId\": \"roboto\",\n  \"ledType\": \"ws2812b\",\n  \"signHeight\": 150,\n  \"wallThickness\": 3,\n  \"baseThickness\": 2\n}"
            }
          }
        },
        {
          "name": "Pet Tag",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/api/export/pet-tag",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"petName\": \"MAX\",\n  \"phoneNumber\": \"555-1234\",\n  \"shape\": \"bone\",\n  \"size\": \"medium\"\n}"
            }
